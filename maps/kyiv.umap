35\u0440\u0435\u0434 \u0437\u0430\u0442\u0440\u0438\u043c\u0430\u043d\u0438\u0445 - \u043b\u0456\u0434\u0435\u0440 \u041a\u0423\u041f\u0420\u0443 \u0421\u0435\u0440\u0433\u0456\u0439 \u041c\u0435\u043b\u044c\u043d\u0438\u0447\u0435\u043d\u043a\u043e. \u0412\u0456\u043d \u0456 \u0442\u0440\u043e\u0454 \u0442\u043e\u0432\u0430\u0440\u0438\u0448\u0456\u0432 \u0436\u0431\u0443\u0440\u043d\u0443\u043b\u0438 \u0443 \u043f\u043b\u0430\u043a\u0430\u0442\u0438, \u044f\u043a\u0456 \u043d\u0435\u0441\u0443\u0442\u044c \u0443 \u0433\u043e\u043b\u043e\u0432\u0456 \u043a\u043e\u043b\u043e\u043d\u0438, \u0444\u0430\u0440\u0431\u0443.*\n\n*\u0412\u0441\u044c\u043e\u0433\u043e, \u0437\u0430 \u0440\u0456\u0437\u043d\u0438\u043c\u0438 \u043e\u0446\u0456\u043d\u043a\u0430\u043c\u0438, \u0443 \u043f\u0435\u0440\u0448\u043e\u0442\u0440\u0430\u0432\u043d\u0435\u0432\u0456\u0439 \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0430\u0446\u0456\u0457 \u043d\u0430 \u0425\u0440\u0435\u0449\u0430\u0442\u0438\u043a\u0443 \u0431\u0435\u0440\u0443\u0442\u044c \u0443\u0447\u0430\u0441\u0442\u044c \u043f\u043e\u043d\u0430\u0434 10 \u0442\u0438\u0441\u044f\u0447 \u043e\u0441\u0456\u0431.* (Unian)", "Lata": "2013", "name": "2013. KPU demonstration", "Attendance": 10000}, "id": "wx3hz"}, {"type": "Feature", "geometry": {"coordinates": [30.560629, 50.427841], "type": "Point"}, "properties": {"name": "2015 \u2013 KPU rally", "description": "The demonstration through Khreschatyk was forbidden\n\n*\u0421\u0435\u0433\u043e\u0434\u043d\u044f, 1 \u043c\u0430\u044f, \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0437\u0430\u043f\u0440\u0435\u0442 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043f\u0440\u0430\u0437\u0434\u043d\u0438\u0447\u043d\u044b\u0445 \u043c\u0435\u0440\u043e\u043f\u0440\u0438\u044f\u0442\u0438\u0439 \u0432 \u0447\u0435\u0441\u0442\u044c \u0414\u043d\u044f \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0439 \u0441\u043e\u043b\u