437\u0430\u0446\u044c\u043a\u0438\u0445 \u043f\u0456\u0441\u0435\u043d\u044c \u0444\u043e\u043b\u044c\u043a\u043b\u043e\u0440\u043d\u0438\u043c\u0438 \u043a\u043e\u043b\u0435\u043a\u0442\u0438\u0432\u0430\u043c\u0438.*\n*\u0410\u0432\u0442\u043e\u0440\u0441\u044c\u043a\u0438\u0439 \u043a\u043e\u043d\u0446\u0435\u0440\u0442 \u0417\u0430\u0441\u043b\u0443\u0436\u0435\u043d\u043e\u0433\u043e \u0430\u0440\u0442\u0438\u0441\u0442\u0430 \u0423\u043a\u0440\u0430\u0457\u043d\u0438 \u0422\u0430\u0440\u0430\u0441\u0430 \u041a\u043e\u043c\u043f\u0430\u043d\u0456\u0447\u0435\u043d\u043a\u0430.*\n*\u041c\u0430\u0439\u0441\u0442\u0435\u0440-\u043a\u043b\u0430\u0441 \u0456\u0437 \u0444\u0435\u0445\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0448\u0430\u0431\u043b\u044f\u0445. \u041f\u043e\u043a\u0430\u0437\u043e\u0432\u0456 \u0433\u0435\u0440\u0446\u0456 (\u0431\u043e\u0457) \u043c\u0456\u0436 \u043a\u043e\u0437\u0430\u043a\u0430\u043c\u0438 \u043d\u0430 \u0447\u0435\u0441\u0442\u044c \u0441\u043b\u0430\u0432\u043d\u043e\u0433\u043e \u0413\u0435\u0442\u044c\u043c\u0430\u043d\u0430 \u0411\u043e\u0433\u0434\u0430\u043d\u0430-\u0417\u0438\u043d\u043e\u0432\u0456\u044f \u0425\u043c\u0435\u043b\u044c\u043d\u0438\u0446\u044c\u043a\u043e\u0433\u043e.*\n*\u0428\u043b\u044f\u0445\u0435\u0442\u0441\u044c\u043a\u0438\u0439 \u0435\u0442\u0438\u043a\u0435\u0442 (\u0434\u0435\u0433\u0443\u0441\u0442\u0430\u0446\u0456\u044f \u0441\u0442\u0430\u0440\u043e\u043f\u0430\u043d\u0441\u044c\u043a\u0438\u0445 \u0445\u043c\u0456\u043b\u044c\u043d\u0438\u0445 \u043d\u0430\u043f\u043e\u0457\u0432).*\n*\u0422\u0430\u043a\u043e\u0436 \u0432 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0456 \u0437\u0430\u0445\u043e\u0434\u0443: \u044f\u0440\u043c\u0430\u0440\u043e\u043a \u043d\u0430\u0440\u043e\u0434\u043d\u0438\u0445 \u043c\u0430\u0439\u0441\u0442\u0440\u0456\u0432, \u043a\u0430\u0442\u0430\u043d\u043d\u044f \u043d\u0430 \u0432\u043e\u0437\u0456, \u043a\u0430\u0442\u0430\u043d\u043d\u044f \u0432\