9\u0434\u0435\u0448\u043d\u0456\u043c \u0414\u043d\u044e \u043f\u0430\u043c'\u044f\u0442\u0456 \u0442\u0430 \u043f\u0440\u0438\u043c\u0438\u0440\u0435\u043d\u043d\u044f \u0456 \u0414\u043d\u044e \u043f\u0435\u0440\u0435\u043c\u043e\u0433\u0438 \u043d\u0430\u0434 \u043d\u0430\u0446\u0438\u0437\u043c\u043e\u043c 8-9 \u0442\u0440\u0430\u0432\u043d\u044f.\n\n*\u041f\u043e \u0432\u0441\u044c\u043e\u043c\u0443 \u0425\u0440\u0435\u0449\u0430\u0442\u0438\u043a\u0443 \u0440\u043e\u0437\u0442\u044f\u0433\u043d\u0443\u043b\u0438\u0441\u044f \u0442\u0435\u043d\u0442\u0438 \u043f\u0456\u0434 \u044f\u043a\u0438\u043c\u0438 \u0432\u0441\u0456 \u043e\u0445\u043e\u0447\u0456 \u043c\u043e\u0433\u043b\u0438 \u0432\u0437\u044f\u0442\u0438 \u0443\u0447\u0430\u0441\u0442\u044c \u0443 \u0432\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u043d\u0456 \u0441\u0438\u043c\u0432\u043e\u043b\u0456\u0447\u043d\u0438\u0445 \u043c\u0430\u043a\u0456\u0432, \u0432\u0456\u043d\u043a\u0456\u0432 \u0442\u0430 \u043d\u0430\u0432\u0447\u0438\u0442\u0438\u0441\u044f \u043f\u0435\u0442\u0440\u0438\u043a\u0456\u0432\u0441\u044c\u043a\u043e\u043c\u0443 \u0440\u043e\u0437\u043f\u0438\u0441\u0443 \u0456 \u0434\u0435\u043a\u0443\u043f\u0430\u0436\u0443. \u0422\u0430\u043a \u043c\u043e\u0436\u043d\u0430 \u0431\u0443\u043b\u043e \u0432\u043b\u0430\u0441\u043d\u043e\u0440\u0443\u0447 \u0432\u0438\u0433\u043e\u0442\u043e\u0432\u0438\u0442\u0438 \u043f\u043e\u0434\u0430\u0440\u0443\u043d\u043a\u0438 \u0432\u0435\u0442\u0435\u0440\u0430\u043d\u0430\u043c \u0434\u043e \u043f\u0440\u0438\u0439\u0434\u0435\u0448\u043d\u0456\u0445 \u0441\u0432\u044f\u0442 8-9 \u0442\u0440\u0430\u0432\u043d\u044f. \u0425\u043e\u0447\u0430 \u043c\u0430\u0439\u0441\u0442\u0435\u0440\u043d\u0456 \u043f\u0440\u0438\u0432\u0430\u0431\u043b\u044e\u0432\u0430\u043b\u0438 \u043f\u0435\u0440\u0435\u0432\u0430\u0436\u043d\u043e \u043c\u0430\u043b\u0435\u0447\u0443, \u0430\u043b\u0435 \u043f\u043e\u0440\u0447\u0456\u0437\u0434\u0456\u0442\u04