 true}, "rank": 0}, {"type": "FeatureCollection", "features": [{"type": "Feature", "geometry": {"type": "LineString", "coordinates": [[30.550025, 50.440348], [30.545427, 50.443758], [30.542123, 50.443976], [30.538837, 50.445877], [30.539348, 50.446113], [30.53886, 50.445904], [30.53489, 50.448022], [30.529719, 50.4504], [30.527573, 50.452464], [30.525556, 50.451165], [30.52444, 50.450427], [30.522262, 50.448465], [30.520321, 50.442357]]}, "properties": {"description": "\u0417\u0433\u0456\u0434\u043d\u043e \u0437 \u0437\u0430\u044f\u0432\u043a\u043e\u044e \u041a\u043e\u043c\u0443\u043d\u0456\u0441\u0442\u0438\u0447\u043d\u043e\u0457 \u043f\u0430\u0440\u0442\u0456\u0457 \u0423\u043a\u0440\u0430\u0457\u043d\u0438, \u0430\u043a\u0446\u0456\u044f \u0440\u043e\u0437\u043f\u043e\u0447\u043d\u0435\u0442\u044c\u0441\u044f \u043e 9-\u0439 \u0433\u043e\u0434\u0438\u043d\u0456 \u0440\u0430\u043d\u043a\u0443 \u0456 \u0437\u0430\u043a\u0456\u043d\u0447\u0438\u0442\u044c\u0441\u044f \u043e 13-\u0439. \u0423\u0447\u0430\u0441\u043d\u0438\u043a\u0438 \u0430\u043a\u0446\u0456\u0457, \u044f\u043a\u0438\u0445 \u0437\u0430\u044f\u0432\u043b\u0435\u043d\u043e 10 \u0442\u0438\u0441\u044f\u0447 \u043e\u0441\u0456\u0431, \u0437\u0431\u0435\u0440\u0443\u0442\u044c\u0441\u044f \u0431\u0456\u043b\u044f \u043c\u0435\u0442\u0440\u043e \u201c\u0410\u0440\u0441\u0435\u043d\u0430\u043b\u044c\u043d\u0430\u201d \u0442\u0430 \u043a\u043e\u043b\u043e\u043d\u043e\u044e \u043f\u0440\u043e\u0439\u0434\u0443\u0442\u044c \u0434\u043e \u043f\u043b\u043e\u0449\u0456 \u0421\u043b\u0430\u0432\u0438, \u043f\u043e\u0442\u0456\u043c \u0432\u0443\u043b\u0438\u0446\u0435\u044e \u0421\u0456\u0447\u043d\u0435\u0432\u043e\u0433\u043e \u043f\u043e\u0432\u0441\u0442\u0430\u043d\u043d\u044f, \u0413\u0440\u0443\u0448\u0435\u0432\u0441\u044c\u043a\u043e\u0433\u043e \u0442\u0430, \u043c\u0438\u043d\u0430\u044e\u0447\u0438 \u0404\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u044c\u043a\u0443 \u043f\u043b\u043e\u0449\u0443, \u0437\u0431\u0435\u0440\u0443\u0442\u044c\u0441\u044f \u043d\u0430 \u041c\u0430\u0439\u0434\u0430\u043d\u0456 \u041d\u0435\u0437\u0430\u043b\u0435\u0436\u043d\u043e\u0441\u0442\u0456 \u043d\u0430 \u043c\u0456\u0442\u0438\u043d\u0433 (11.00-12.00). \u041f\u0456\u0441\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u043a\u043e\u043b\u043e\u043d\u0430 \u0425\u0440\u0435\u0449\u0430\u0442\u0438\u043a\u043e\u043c \u0440\u0443\u0448\u0438\u0442\u044c \u0434\u043e \u0411\u0435\u0441\u0441\u0430\u0440\u0430\u0431\u0441\u044c\u043a\u043e\u0457 \u043f\u043b\u043e\u0449\u0456, \u0434\u0430\u043b\u0456 \u0434\u043e \u043f\u0430\u043c\u2019\u044f\u0442\u043d\u0438\u043a\u0430 \u041b\u0435\u043d\u0456\u043d\u0443, \u0434\u0435 \u0431\u0443\u0434\u0443\u0442\u044c \u043f\u043e\u043a\u043b\u0430\u0434\u0435\u043d\u0456 \u043a\u0432\u0456\u0442\u0438 (unian)\n\nAttendance: 2000 (radio svobody)", "Attendance": 2000, "Lata": "2007"}, "id": "ngNHF"}, {"type": "Feature", "geometry": {"coordinates": [[30.527557, 50.452408], [30.524526, 50.450454], [30.523152, 50.449375], [30.522229, 50.44831], [30.520298, 50.442311]], "type": "LineString"}, "properties": {"name": "1991 Official Demonstration", "Attendance": 50000, "Lata": "1991"}, "id": "9nKG0"}, {"type": "Feature", "geometry": {"coordinates": [30.527297, 50.452355], "type": "Point"}, "properties": {"name": "1991 Rally ", "description": "Wiec pierwszomajowy, zorganizowany z inicjatywy komitetu miejskiego partii komunistycznej, miejskiego komitetu zw\u0105zkowego, spo\u0142ecznych komitet\u00f3w robotniczych; przyjechali delegaci z miast Ukrainy\n (Vremya tv, z youtube)", "Lata": "1991"}, "id": "B18Pe"}, {"type": "Feature", "geometry": {"coordinates": [30.527787, 50.452394], "type": "Point"}, "properties": {"name": "1999 Communist Rally", "description": "*1 \u0422\u0440\u0430\u0432\u043d\u044f \u0432 \u041a\u0438\u0454\u0432\u0456 \u043f\u0440\u043e\u0432\u0435\u043b\u0438 \u0434\u0435-\u043c\u043e\u043d\u0441\u0442\u0440\u0430\u0446\u0456\u044e 