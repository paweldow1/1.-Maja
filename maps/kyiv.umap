{"type": "umap", "geometry": {"type": "Point", "coordinates": [30.521049499511722, 50.45743571519838]}, "properties": {"ttl": {"300": "5 min", "3600": "1 hour", "86400": "1 day"}, "name": "May Day_Kyiv", "zoom": 15, "rules": [{"name": "Attendance>29999", "condition": "Attendance>29999", "properties": {"weight": 18, "iconClass": "LargeCircle", "fillOpacity": 1, "iconOpacity": 1}}, {"name": "Attendance>19999", "condition": "Attendance>19999", "properties": {"weight": 16}}, {"name": "Attendance>14999", "condition": "Attendance>14999", "properties": {"weight": 14}}, {"name": "Attendance>9999", "condition": "Attendance>9999", "properties": {"weight": 12}}, {"name": "Attendance>7499", "condition": "Attendance>7499", "properties": {"weight": 10}}, {"name": "Attendance>4999", "condition": "Attendance>4999", "properties": {"weight": 9}}, {"name": "Attendance>2999", "condition": "Attendance>2999", "properties": {"weight": 7}}, {"name": "Attendance>1999", "condition": "Attendance>1999", "properties": {"weight": 6}}, {"name": "Attendance>999", "condition": "Attendance>999", "properties": {"weight": 5}}, {"name": "Attendance>499", "condition": "Attendance>499", "properties": {"weight": 4}}, {"name": "Attendance>249", "condition": "Attendance>249", "properties": {"weight": 3}}, {"name": "Attendance>99 ", "condition": "Attendance>99 ", "properties": {"weight": 2}}, {"name": "Attendance<100", "condition": "Attendance<100", "properties": {"weight": 1}}], "center": [30.521049499511722, 50.45743571519838], "fields": [{"key": "Lata", "type": "Enum"}], "filters": [{"widget": "Radio", "fieldKey": "Lata"}], "overlay": {}, "iconSize": 20, "iconClass": "LargeCircle", "slideshow": {}, "tilelayer": {"tms": false, "name": "OSM Piano EN", "maxZoom": 20, "minZoom": 0, "attribution": "map data \u00a9 [[http://osm.org/copyright|OpenStreetMap contributors]] under ODbL - tiles \u00a9 [[https://github.com/tilery/pianoforte|Min. Aff. \u00c9trang\u00e8res]]", "url_template": "https://{s}.piano.tiles.quaidorsay.fr/en/{z}/{x}/{y}.png"}, "limitBounds": {}, "zoomControl": true, "fullscreenControl": true}, "uri": "http://umap.openstreetmap.fr/en/map/may-day_kyiv_1431412", "layers": [{"type": "FeatureCollection", "features": [{"type": "Feature", "geometry": {"type": "Point", "coordinates": [30.539455, 50.446092]}, "properties": {"name": "General Vatutin Monument", "Lata": "2007", "description": "## 2007\n\u0411\u043b\u0438\u0437\u044c\u043a\u043e 2-\u0445 \u0442\u0438\u0441\u044f\u0447 \u043f\u0440\u0438\u0445\u0438\u043b\u044c\u043d\u0438\u043a\u0456\u0432 \u041a\u043e\u043c\u0443\u043d\u0456\u0441\u0442\u0438\u0447\u043d\u043e\u0457 \u043f\u0430\u0440\u0442\u0456\u0457 \u0432\u0440\u0430\u043d\u0446\u0456 \u0440\u043e\u0437\u043f\u043e\u0447\u0430\u043b\u0438 \u0445\u043e\u0434\u0443 \u041a\u0438\u0454\u0432\u043e\u043c \u0432\u0456\u0434 \u0441\u0442\u0430\u043d\u0446\u0456\u0457 \u043c\u0435\u0442\u0440\u043e \u201c\u0410\u0440\u0441\u0435\u043d\u0430\u043b\u044c\u043d\u0430\u201d. \u041b\u0456\u0434\u0435\u0440\u0438 \u043f\u0430\u0440\u0442\u0456\u0457 \u041f\u0435\u0442\u0440\u043e \u0421\u0438\u043c\u043e\u043d\u0435\u043d\u043a\u043e \u0442\u0430 \u0410\u0434\u0430\u043c \u041c\u0430\u0440\u0442\u0438\u043d\u044e\u043a \u043f\u043e\u0432\u0435\u043b\u0438 \u043a\u043e\u043b\u043e\u043d\u0443 \u0432\u0443\u043b\u0438\u0446\u0435\u044e \u0413\u0440\u0443\u0448\u0435\u0432\u0441\u044c\u043a\u043e\u0433\u043e \u0434\u043e \u043f\u0430\u043c\u2019\u044f\u0442\u043d\u0438\u043a\u0430 \u0433\u0435\u043d\u0435\u0440\u0430\u043b\u0443 \u0412\u0430\u0442\u0443\u0442\u0456\u043d\u0443, \u043f\u043e\u0442\u0456\u043c \u0441\u043f\u0443\u0441\u0442\u0438\u043b\u0438\u0441\u044c \u043d\u0430 \u0404\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u044c\u043a\u0443 \u043f\u043b\u043e\u0449\u0443, \u0425\u0440\u0435\u0449\u0430\u0442\u0438\u043a\u043e\u043c \u043f\u0440\u043e\u0439\u0448\u043b\u0438 \u0434\u043e \u041c\u0430\u0439\u0434\u0430\u043d\u0443 \u041d\u0435\u0437\u0430\u043b\u0435\u0436\u043d\u043e\u0441\u0442\u0456, \u0434\u0435 \u043f\u0440\u043e\u0432\u0435\u043b\u0438 \u043c\u0456\u0442\u0438\u043d\u0433, \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u0438\u0432 \u043a\u043e\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442 \u0420\u0430\u0434\u0456\u043e \u0421\u0432\u043e\u0431\u043e\u0434\u0430.\n\n\u0406\u043d\u0448\u0430 \u0447\u0430\u0441\u0442\u0438\u043d\u0430 \u043c\u0456\u0442\u0438\u043d\u0443\u0432\u0430\u043b\u044c\u043d\u0438\u043a\u0456\u0432 \u0432\u0438\u0440\u0443\u0448\u0438\u043b\u0430 \u0434\u043e \u043f\u0430\u043c\u2019\u044f\u0442\u043d\u0438\u043a\u0430 \u041b\u0435\u043d\u0456\u043d\u0443, \u0449\u043e\u0431 \u043f\u043e\u043a\u043b\u0430\u0441\u0442\u0438 \u043a\u0432\u0456\u0442\u0438 \u0437 \u043d\u0430\u0433\u043e\u0434\u0438 \u0414\u043d\u044f \u0441\u043e\u043b\u0456\u0434\u0430\u0440\u043d\u043e\u0441\u0442\u0456 \u0442\u0440\u0443\u0434\u044f\u0449\u0438\u0445.", "_umap_options": {"iconUrl": "https://raw.githubusercontent.com/paweldow1/umap-assets/main/logo/kijow/pomniki/watutin.png"}}, "id": "tccnf"}, {"type": "Feature", "geometry": {"coordinates": [30.527449, 50.446065], "type": "Point"}, "properties": {"osm_type": "N", "osm_id": 1297629632, "osm_key": "historic", "osm_value": "memorial", "type": "house", "name": "Ivan Franko Monument", "street": "Ivana Franka Square", "locality": "\u0413\u0440\u0430\u0444\u0441\u044c\u043a\u0430 \u0413\u043e\u0440\u0430", "district": "Pecherskyi district", "city": "Kyiv", "country": "Ukraine", "postcode": "01024", "countrycode": "UA", "_umap_options": {"iconUrl": "https://raw.githubusercontent.com/paweldow1/umap-assets/main/logo/kijow/pomniki/franko.png"}}, "id": "nYiT1"}, {"type": "Feature", "geometry": {"coordinates": [30.519612, 50.442445], "type": "Point"}, "properties": {"name": "Lenin's Monument", "Lata": "1990, 1991, 1993, 2003, 2004, 2005, 2006, 2007, 2008, 2009, 2010, 2013", "description": "The monument of Lenin erected in december 1946, in front of which wreaths were layed before the beginning of the May Day parades up until december 2013, when it was knocked down during the Revolution of Dignity. The event initiated the so called \"Leninopad\" \u2013 movement of toppling the communist-era monuments across Ukraine.\n\nOn June 30th 2009 (birthday of Roman Shukhevych), the monument was defaced by Ukrainian nationalists protesting the slow pace of decommunisation announced by president Jushchenko. Since then, monument had been guarded by KPU members, most likely especially on symbolic dates (Svoboda 2011)\n\n## 1990\n\n## 1991\n\n*\u201c\u041f\u0435\u0440\u0435\u0434 \u043d\u0430\u0447\u0430\u043b\u043e\u043c \u043c\u0430\u043d\u0438\u0444\u0435\u0441\u0442\u0430\u0446\u0438\u0438 \u041f\u0440\u0435\u0434\u0441\u0435\u0434\u0430\u0442\u0435\u043b\u044c \u0412\u0435\u0440\u0445\u043e\u0432\u043d\u043e\u0433\u043e \u0421\u043e\u0432\u0435\u0442\u0430 \u0423\u043a\u0440\u0430\u0438\u043d\u0441\u043a\u043e\u0439 \u0421\u0421\u0420 \u041b. \u041c. \u041a\u0440\u0430\u0432\u0447\u0443\u043a, \u0447\u043b\u0435\u043d \u041f\u043e\u043b\u0438\u0442\u0431\u044e\u0440\u043e \u0426\u041a \u041a\u041f\u0421\u0421, \u043f\u0435\u0440\u0432\u044b\u0439 \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u044c \u0426\u041a \u041a\u043e\u043c\u043f\u0430\u0440\u0442\u0438\u0438 \u0423\u043a\u0440\u0430\u0438\u043d\u044b \u0421. \u0418. \u0413\u0443\u0440\u0435\u043d\u043a\u043e, \u043d\u0430\u0440\u043e\u0434\u043d\u044b\u0435 \u0434\u0435\u043f\u0443\u0442\u0430\u0442\u044b, \u0447\u043b\u0435\u043d\u044b \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0440\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0438 \u0432\u043e\u0437\u043b\u043e\u0436\u0438\u043b\u0438 \u0446\u0432\u0435\u0442\u044b \u043a \u043f\u0430\u043c\u044f\u0442\u043d\u0438\u043a\u0443 \u0412. \u0418. \u041b\u0435\u043d\u0438\u043d\u0443. \u0417\u0430\u0442\u0435\u043c \u043a\u043e\u043b\u043e\u043d\u043d\u044b \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043a \u043f\u043b\u043e\u0449\u0430\u0434\u0438 \u041e\u043a\u0442\u044f\u0431\u0440\u044c\u0441\u043a\u043e\u0439 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438* (Pravda Ukrainy, 2.05.1991)\n\n## 2003\n\n\u041f\u0456\u0441\u043b\u044f \u043c\u0456\u0442\u0438\u043d\u0433\u0443 \u043a\u043e\u043b\u043e\u043d\u0430 \u043f\u0440\u043e\u0439\u0434\u0435 \u0425\u0440\u0435\u0449\u0430\u0442\u0438\u043a\u043e\u043c, \u043f\u0456\u0441\u043b\u044f \u0447\u043e\u0433\u043e \u043a\u043e\u043c\u0443\u043d\u0456\u0441\u0442\u0438 \u0456 \u0441\u043e\u0446\u0456\u0430\u043b\u0456\u0441\u0442\u0438 \u043f\u043e\u043a\u043b\u0430\u0434\u0443\u0442\u044c \u043a\u0432\u0456\u0442\u0438 \u0434\u043e \u043f\u0430\u043c'\u044f\u0442\u043d\u0438\u043a\u0430 \u041b\u0435\u043d\u0456\u043d\u0443 \u043d\u0430 \u0431\u0443\u043b\u044c\u0432\u0430\u0440\u0456 \u0428\u0435\u0432\u0447\u0435\u043d\u043a\u0430, \u0430 \"\u0411\u0430\u0442\u044c\u043a\u0456\u0432\u0449\u0438\u043d\u0430\" \u0456 \"\u0421\u043e\u0431\u043e\u0440\" - \u0434\u043e \u043f\u0430\u043c'\u044f\u0442\u043d\u0438\u043a\u0430 \u0413\u0440\u0443\u0448\u0435\u0432\u0441\u044c\u043a\u043e\u0433\u043e \u043d\u0430 \u0432\u0443\u043b\u0438\u0446\u0456 \u0412\u043e\u043b\u043e\u0434\u0438\u043c\u0438\u0440\u0441\u044c\u043a\u0456\u0439. (UP 29.04.2003)\n\n## 2004 \n\u041d\u0430 \u043c\u0456\u0442\u0438\u043d\u0433\u0443 [\u041a\u041f\u0423] \u0437\u0432\u0443\u0447\u0430\u043b\u0438 \u043f\u0440\u0438\u0432\u0456\u0442\u0430\u043d\u043d\u044f \u0437 \u041c\u0456\u0436\u043d\u0430\u0440\u043e\u0434\u043d\u0438\u043c \u0434\u043d\u0435\u043c \u0441\u043e\u043b\u0456\u0434\u0430\u0440\u043d\u043e\u0441\u0442\u0456 \u0442\u0440\u0443\u0434\u044f\u0449\u0438\u0445, \u0430 \u0442\u0430\u043a\u043e\u0436 \u0430\u043d\u0442\u0438\u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u0441\u044c\u043a\u0456 \u0433\u0430\u0441\u043b\u0430. \u041f\u0456\u0441\u043b\u044f \u0437\u0430\u043a\u0456\u043d\u0447\u0435\u043d\u043d\u044f \u0437\u0430\u0445\u043e\u0434\u0443 \u0431\u0456\u043b\u044c\u0448\u0456\u0441\u0442\u044c \u0439\u043e\u0433\u043e \u0443\u0447\u0430\u0441\u043d\u0438\u043a\u0456\u0432 \u043f\u043e\u043a\u043b\u0430\u043b\u0438 \u043a\u0432\u0456\u0442\u0438 \u0434\u043e \u043f\u0430\u043c\"\u044f\u0442\u043d\u0438\u043a\u0430 \u041b\u0435\u043d\u0456\u043d\u0443. (korespondent.net)\n\n## 2005\n\u041a\u043e\u043c\u043c\u0443\u043d\u0438\u0441\u0442\u044b \u0441\u043e\u0431\u0440\u0430\u043b\u0438\u0441\u044c \u0443\u0442\u0440\u043e\u043c \u0443 \u0441\u0442\u0430\u043d\u0446\u0438\u0438 \u043c\u0435\u0442\u0440\u043e \"\u0410\u0440\u0441\u0435\u043d\u0430\u043b\u044c\u043d\u0430\u044f\", \u0430 \u0437\u0430\u0442\u0435\u043c \u043a\u043e\u043b\u043e\u043d\u043d\u043e\u0439 \u0434\u0432\u0438\u0433\u0430\u043b\u0438\u0441\u044c \u0434\u043e \u041a\u0440\u0435\u0449\u0430\u0442\u0438\u043a\u0430, \u0432\u043e\u0437\u043b\u043e\u0436\u0438\u043b\u0438 \u0446\u0432\u0435\u0442\u044b \u043a \u043f\u0430\u043c\u044f\u0442\u043d\u0438\u043a\u0443 \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440\u0443 \u041b\u0435\u043d\u0438\u043d\u0443, \u0430 \u0437\u0430\u0442\u0435\u043c \u043d\u0430\u0447\u0430\u043b\u0441\u044f \u043c\u0438\u0442\u0438\u043d\u0433 (korrespondient.net)\n\n## 2006\n\n\u0421\u044c\u043e\u0433\u043e\u0434\u043d\u0456 \u0432 \u041a\u0438\u0454\u0432\u0456 \u0437 \u043d\u0430\u0433\u043e\u0434\u0438 \u041c\u0456\u0436\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u0434\u043d\u044f \u0441\u043e\u043b\u0456\u0434\u0430\u0440\u043d\u043e\u0441\u0442\u0456 \u0442\u0440\u0443\u0434\u044f\u0449\u0438\u0445 \u0431\u043b\u0438\u0437\u044c\u043a\u043e 30 \u043f\u0440\u0438\u0445\u0438\u043b\u044c\u043d\u0438\u043a\u0456\u0432 \u041f\u0421\u041f\u0423 \u0437\u0430 \u0432\u0456\u0434\u0441\u0443\u0442\u043d\u043e\u0441\u0442\u0456 \u043b\u0456\u0434\u0435\u0440\u0456\u0432 \u043f\u0430\u0440\u0442\u0456\u0457 \u043f\u043e\u043a\u043b\u0430\u043b\u0438 \u043a\u0432\u0456\u0442\u0438 \u0434\u043e \u043f\u0430\u043c\u2019\u044f\u0442\u043d\u0438\u043a\u0430 \u0432\u043e\u0436\u0434\u0435\u0432\u0456 \u0441\u0432\u0456\u0442\u043e\u0432\u043e\u0433\u043e \u043f\u0440\u043e\u043b\u0435\u0442\u0430\u0440\u0456\u0430\u0442\u0443 \u0412\u043e\u043b\u043e\u0434\u0438\u043c\u0438\u0440\u0443 \u041b\u0435\u043d\u0456\u043d\u0443, \u043f\u0435\u0440\u0435\u0434\u0430\u0454 \u0423\u041d\u0406\u0410\u041d. (korrespondient)\n\n## 2007\n\u041b\u0456\u0434\u0435\u0440\u0438 \u043f\u0430\u0440\u0442\u0456\u0457 \u041f\u0435\u0442\u0440\u043e \u0421\u0438\u043c\u043e\u043d\u0435\u043d\u043a\u043e \u0442\u0430 \u0410\u0434\u0430\u043c \u041c\u0430\u0440\u0442\u0438\u043d\u044e\u043a \u043f\u043e\u0432\u0435\u043b\u0438 \u043a\u043e\u043b\u043e\u043d\u0443 \u0432\u0443\u043b\u0438\u0446\u0435\u044e \u0413\u0440\u0443\u0448\u0435\u0432\u0441\u044c\u043a\u043e\u0433\u043e \u0434\u043e \u043f\u0430\u043c\u2019\u044f\u0442\u043d\u0438\u043a\u0430 \u0433\u0435\u043d\u0435\u0440\u0430\u043b\u0443 \u0412\u0430\u0442\u0443\u0442\u0456\u043d\u0443, \u043f\u043e\u0442\u0456\u043c \u0441\u043f\u0443\u0441\u0442\u0438\u043b\u0438\u0441\u044c \u043d\u0430 \u0404\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u044c\u043a\u0443 \u043f\u043b\u043e\u0449\u0443, \u0425\u0440\u0435\u0449\u0430\u0442\u0438\u043a\u043e\u043c \u043f\u0440\u043e\u0439\u0448\u043b\u0438 \u0434\u043e \u041c\u0430\u0439\u0434\u0430\u043d\u0443 \u041d\u0435\u0437\u0430\u043b\u0435\u0436\u043d\u043e\u0441\u0442\u0456, \u0434\u0435 \u043f\u0440\u043e\u0432\u0435\u043b\u0438 \u043c\u0456\u0442\u0438\u043d\u0433, \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u0438\u0432 \u043a\u043e\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442 \u0420\u0430\u0434\u0456\u043e \u0421\u0432\u043e\u0431\u043e\u0434\u0430. \u0406\u043d\u0448\u0430 \u0447\u0430\u0441\u0442\u0438\u043d\u0430 \u043c\u0456\u0442\u0438\u043d\u0443\u0432\u0430\u043b\u044c\u043d\u0438\u043a\u0456\u0432 \u0432\u0438\u0440\u0443\u0448\u0438\u043b\u0430 \u0434\u043e \u043f\u0430\u043c\u2019\u044f\u0442\u043d\u0438\u043a\u0430 \u041b\u0435\u043d\u0456\u043d\u0443, \u0449\u043e\u0431 \u043f\u043e\u043a\u043b\u0430\u0441\u0442\u0438 \u043a\u0432\u0456\u0442\u0438 \u0437 \u043d\u0430\u0433\u043e\u0434\u0438 \u0414\u043d\u044f \u0441\u043e\u043b\u0456\u0434\u0430\u0440\u043d\u043e\u0441\u0442\u0456 \u0442\u0440\u0443\u0434\u044f\u0449\u0438\u0445. (Radio Svoboda)\n\n## 2008\n\n*\u0421\u043e\u043e\u0431\u0449\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u043e\u043a\u043e\u043b\u043e 4 \u0442\u044b\u0441. \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u043a\u043e\u0432 \u041a\u043e\u043c\u043c\u0443\u043d\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0438 \u041f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u043e\u0439 \u0441\u043e\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u0430\u0440\u0442\u0438\u0439 \u043f\u0440\u043e\u0448\u043b\u0438 \u043c\u0430\u0440\u0448\u0435\u043c \u043e\u0442 \u043f\u0430\u043c\u044f\u0442\u043d\u0438\u043a\u0430 \u041b\u0435\u043d\u0438\u043d\u0443 \u0434\u043e \u0415\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0439 \u043f\u043b\u043e\u0449\u0430\u0434\u0438 \u043f\u043e \u0441\u043b\u0443\u0447\u0430\u044e 1 \u041c\u0430\u044f. **\u041c\u0435\u0440\u043e\u043f\u0440\u0438\u044f\u0442\u0438\u0435 \u043d\u0430\u0447\u0430\u043b\u043e\u0441\u044c \u043e\u043a\u043e\u043b\u043e 10:00 \u0432\u043e\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c \u0446\u0432\u0435\u0442\u043e\u0432 \u043b\u0438\u0434\u0435\u0440\u0430\u043c\u0438 \u041a\u041f\u0423 \u041f\u0435\u0442\u0440\u043e\u043c \u0421\u0438\u043c\u043e\u043d\u0435\u043d\u043a\u043e \u0438 \u041f\u0421\u041f\u0423 \u041d\u0430\u0442\u0430\u043b\u0438\u0435\u0439 \u0412\u0438\u0442\u0440\u0435\u043d\u043a\u043e \u043a \u043f\u0430\u043c\u044f\u0442\u043d\u0438\u043a\u0443 \u041b\u0435\u043d\u0438\u043d\u0443.*** (Korrespondent)\n\n## 2009\n*\u0412 10:00 \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u0430\u0441\u044c \u0442\u043e\u0440\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u0446\u0435\u0440\u0435\u043c\u043e\u043d\u0438\u044f \u0432\u043e\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0446\u0432\u0435\u0442\u043e\u0432 \u043a \u043f\u0430\u043c\u044f\u0442\u043d\u0438\u043a\u0443 \u0412.\u0418. \u041b\u0435\u043d\u0438\u043d\u0443, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043f\u0440\u0438\u043d\u044f\u043b\u0438 \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u043b\u0438\u0434\u0435\u0440 \u041a\u043e\u043c\u043f\u0430\u0440\u0442\u0438\u0438 \u0423\u043a\u0440\u0430\u0438\u043d\u044b \u041f\u0451\u0442\u0440 \u0421\u0438\u043c\u043e\u043d\u0435\u043d\u043a\u043e, \u043f\u0435\u0440\u0432\u044b\u0439 \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u044c \u041a\u0438\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u0433\u043e\u0440\u043a\u043e\u043c\u0430 \u041a\u041f\u0423 \u042e\u0440\u0438\u0439 \u0421\u0438\u0437\u0435\u043d\u043a\u043e, \u0447\u043b\u0435\u043d\u044b \u0426\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u041a\u043e\u043c\u0438\u0442\u0435\u0442\u0430 \u043f\u0430\u0440\u0442\u0438\u0438, \u043d\u0430\u0440\u043e\u0434\u043d\u044b\u0435 \u0434\u0435\u043f\u0443\u0442\u0430\u0442\u044b \u0423\u043a\u0440\u0430\u0438\u043d\u044b, \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043b\u0438 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u0438.* (kprf1MayaNa2009)\n\n## 2010\n*\u041f\u0435\u0440\u0435\u0434 \u043f\u043e\u0447\u0430\u0442\u043a\u043e\u043c \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0430\u0446\u0456\u0457 \u043b\u0456\u0434\u0435\u0440\u0438 \"\u0421\u043e\u044e\u0437\u0443 \u043b\u0456\u0432\u0438\u0445 \u0441\u0438\u043b\" \u043f\u043e\u043a\u043b\u0430\u043b\u0438 \u043a\u0432\u0456\u0442\u0438 \u0434\u043e \u043f\u0430\u043c'\u044f\u0442\u043d\u0438\u043a\u0430 \u041b\u0435\u043d\u0456\u043d\u0443 \u043d\u0430 \u0411\u0435\u0441\u0441\u0430\u0440\u0430\u0431\u0441\u044c\u043a\u0456\u0439 \u043f\u043b\u043e\u0449\u0456.*\n\n## 2013\n\nBefore the start of demonstration, Petr Symonenko and a KPU politician laid wreaths by the monument; smaller bouquets roses and carnations were allready laid there (TSN youtube 2013)\n(TSN news)", "_umap_options": {"iconUrl": "https://raw.githubusercontent.com/paweldow1/umap-assets/main/logo/kijow/pomniki/lenin.png"}}, "id": "p3D9N"}, {"type": "Feature", "geometry": {"type": "Point", "coordinates": [30.53635, 50.449203]}, "properties": {"name": "Lesya Ukrainka Monument", "Lata": "2003, 2004", "description": "## 2003\n\n\u0422\u0430\u043a\u043e\u0436 \u043f\u0440\u043e \u043d\u0430\u043c\u0456\u0440 \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u0443 \u0441\u0442\u043e\u043b\u0438\u0446\u0456 \u0423\u043a\u0440\u0430\u0457\u043d\u0438 \u043f\u0435\u0440\u0448\u043e\u0442\u0440\u0430\u0432\u043d\u0435\u0432\u0443 \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0430\u0446\u0456\u044e \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u044f\u0454 \u041a\u0438\u0457\u0432\u0441\u044c\u043a\u0430 \u043c\u0456\u0441\u044c\u043a\u0430 \u043e\u0440\u0433\u0430\u043d\u0456\u0437\u0430\u0446\u0456\u044f \u0421\u0414\u041f\u0423(\u041e). (...) \u041e\u0431 11.40 \u0443\u0447\u0430\u0441\u043d\u0438\u043a\u0438 \u0430\u043a\u0446\u0456\u0457 \u043f\u043e\u043a\u043b\u0430\u0434\u0443\u0442\u044c \u043a\u0432\u0456\u0442\u0438 \u0434\u043e \u043f\u0430\u043c'\u044f\u0442\u043d\u0438\u043a\u0430 \u041b\u0435\u0441\u0456 \u0423\u043a\u0440\u0430\u0457\u043d\u0446\u0456 (\u0426\u041f\u041a\u0406\u0412). \u041e 12.50 \u043d\u0430 \u043b\u0456\u0442\u043d\u044c\u043e\u043c\u0443 \u043c\u0430\u0439\u0434\u0430\u043d\u0447\u0438\u043a\u0443 \u0426\u041f\u041a\u0406\u0412 \u0432\u0456\u0434\u0431\u0443\u0434\u0435\u0442\u044c\u0441\u044f \u0441\u0432\u044f\u0442\u043a\u043e\u0432\u0438\u0439 \u043c\u0456\u0442\u0438\u043d\u0433, \u043f\u043e \u0437\u0430\u043a\u0456\u043d\u0447\u0435\u043d\u043d\u0456 \u044f\u043a\u043e\u0433\u043e - \u043a\u043e\u043d\u0446\u0435\u0440\u0442. (UP 29.04.2003)\n\n## 2004\nSDPU(o) demonstration lays flowers in front of the monument", "_umap_options": {"iconUrl": "https://raw.githubusercontent.com/paweldow1/umap-assets/main/logo/kijow/pomniki/lesia_ukrainka.png"}}, "id": "Ghvjb"}, {"type": "Feature", "geometry": {"type": "Point", "coordinates": [30.518221, 50.463032]}, "properties": {"name": "Petro Sagaidachnyi Monument", "_umap_options": {"iconUrl": "https://raw.githubusercontent.com/paweldow1/umap-assets/main/logo/kijow/pomniki/sahaidachny.png"}}, "id": "AJ4TA"}, {"type": "Feature", "geometry": {"coordinates": [30.513169, 50.441727], "type": "Point"}, "properties": {"name": "Taras Shevchenko monument", "_umap_options": {"iconUrl": "https://raw.githubusercontent.com/paweldow1/umap-assets/main/logo/kijow/pomniki/shevchenko.png"}, "description": "## 1996\nNarodnyi Rukh rally takes place at the square; flowers and wreaths in front of Shevchenko's monument are laid by rally participants. (Suspilne Mediateka)\n\n## 2003\n\n*\u041f\u0456\u0441\u043b\u044f \u043c\u0456\u0442\u0438\u043d\u0433\u0443 \u043a\u043e\u043b\u043e\u043d\u0430 \u043f\u0440\u043e\u0439\u0434\u0435 \u0425\u0440\u0435\u0449\u0430\u0442\u0438\u043a\u043e\u043c, \u043f\u0456\u0441\u043b\u044f \u0447\u043e\u0433\u043e \u043a\u043e\u043c\u0443\u043d\u0456\u0441\u0442\u0438 \u0456 \u0441\u043e\u0446\u0456\u0430\u043b\u0456\u0441\u0442\u0438 \u043f\u043e\u043a\u043b\u0430\u0434\u0443\u0442\u044c \u043a\u0432\u0456\u0442\u0438 \u0434\u043e \u043f\u0430\u043c'\u044f\u0442\u043d\u0438\u043a\u0430 \u041b\u0435\u043d\u0456\u043d\u0443 \u043d\u0430 \u0431\u0443\u043b\u044c\u0432\u0430\u0440\u0456 \u0428\u0435\u0432\u0447\u0435\u043d\u043a\u0430, \u0430 \"\u0411\u0430\u0442\u044c\u043a\u0456\u0432\u0449\u0438\u043d\