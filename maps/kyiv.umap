434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0430\u0446\u0456\u0457 \u0456 \u043c\u0456\u0442\u0438\u043d\u0433\u0443 \u0434\u043e \u041a\u0438\u0454\u0432\u0430 \u043f\u0440\u0438\u0457\u0445\u0430\u043b\u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u0438 \u043f\u0430\u0440\u0442\u0456\u0457 \u0437 \u0443\u0441\u0456\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439 \u0423\u043a\u0440\u0430\u0457\u043d\u0438, \u044f\u043a\u0456 \u043f\u0456\u0434\u043f\u0438\u0448\u0443\u0442\u044c \u043f\u0456\u0434 \u0430\u0440\u043a\u043e\u044e \u0414\u0440\u0443\u0436\u0431\u0438 \u043d\u0430\u0440\u043e\u0434\u0456\u0432 \u0443\u0433\u043e\u0434\u0443 \u043f\u0440\u043e \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0457 \u043e\u043f\u043e\u0437\u0438\u0446\u0456\u0457.* (Ukrainska Pravda)\n\n"}, "id": "AyWO9"}, {"type": "Feature", "geometry": {"type": "Point", "coordinates": [30.521931, 50.447743]}, "properties": {"description": "\u041f\u0421\u041f\u0423 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u0442 \u0430\u0433\u0438\u0442\u0430\u0446\u0438\u044e \u0432\u043e\u0437\u043b\u0435 \u0441\u0442\u0430\u043d\u0446\u0438\u0438 \u043c\u0435\u0442\u0440\u043e \"\u041a\u0440\u0435\u0449\u0430\u0442\u0438\u043a\". \u0421 \u044d\u0442\u043e\u0439 \u0446\u0435\u043b\u044c\u044e \u043f\u0430\u0440\u0442\u0438\u044f \u043d\u0430\u043c\u0435\u0440\u0435\u043d\u0430 \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0442\u0430\u043c 6 \u043f\u0430\u043b\u0430\u0442\u043e\u043a (\u0441 12.00 \u0434\u043e 17.00).", "Lata": "2005", "name": "2005. PSPU rally"}, "id": "hdOtr"}, {"type": "Feature", "geometry": {"type": "LineString", "coordinates": [[30.520605, 50.443735], [30.520139, 50.442348]]}, "properties": {"Lata": "2006", "name": "2006. PSPU demonstration", "Attendance": 100, "description": "*\u041f\u0440\u043e\u0433\u0440\u0435\u0441\u0438\u0432\u043d\u043e-\u0441\u043e\u0446\u0456\u0430\u043b\u0456\u0441\u0442\u0438\u0447\u043d\u0430 \u043f\u0430\u0440\u0442\u0456\u044f \u0423\u043a\u0440\u0430\u0457\u043d\u0438 \u043f\u043b\u0430\u043d\u0443\u0454 \u0430\u043a\u0446\u0456\u044e \u0437\u0430 \u0443\u0447\u0430\u0441\u0442\u044e 100 \u0447\u043e\u043b\u043e\u0432\u0456\u043a \u0437 10:00 \u0434\u043e 12:00 \u0432\u0456\u0434 \u0432\u0443\u043b\u0438\u0446\u0456 \u0425\u0440\u0435\u0449\u0430\u0442\u0438\u043a, 42 \u0434\u043e \u043f\u0430\u043c\u2019\u044f\u0442\u043d\u0438\u043a\u0430 \u041b\u0435\u043d\u0456\u043d\u0443, \u0434\u043e \u044f\u043a\u043e\u0433\u043e \u043f\u043e\u043a\u043b\u0430\u0434\u0443\u0442\u044c \u043a\u0432\u0456\u0442\u0438.* (Korrespondent)"}, "id": "AiFC0"}, {"type": "Feature", "geometry": {"type": "LineString", "coordinates": [[30.54549, 50.443759], [30.542101, 50.444114], [30.535255, 50.447831], [30.533474, 50.446478], [30.523796, 50.450229]]}, "properties": {"_umap_options": {"dashArray": "10"}, "Lata": "2009", "name": "2009. Left PSPU led demonstration", "description": "*\u0423 \u0442\u043e\u0439 \u0436\u0435 \u0447\u0430\u0441 \u0431\u0456\u043b\u044f \u043c\u0435\u0442\u0440\u043e \"\u0410\u0440\u0441\u0435\u043d\u0430\u043b\u044c\u043d\u0430\" \u0437\u0431\u0438\u0440\u0430\u044e\u0442\u044c\u0441\u044f \u043f\u0440\u0438\u0445\u0438\u043b\u044c\u043d\u0438\u043a\u0438 \u041f\u0421\u041f\u0423, \u043f\u0430\u0440\u0442\u0456\u0457 \"\u0421\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u0456\u0441\u0442\u044c\", \u043f\u0430\u0440\u0442\u0456\u0457 \"\u041a\u0438\u0457\u0432\u0441\u044c\u043a\u0430 \u0420\u0443\u0441\u044c\", \u043e\u0431'\u0454\u0434\u043d\u0430\u043d\u043d\u044f \"\u041d\u0430\u0448\u0430 \u0441\u0438\u043b\u0430 \u0432 \u0454\u0434\u043d\u043e\u0441\u0442\u0456\", \u0423\u0441\u0435\u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u043e\u0457 \u0433\u0440\u043e\u043c\u0430\u0434\u0441\u044c\u043a\u043e \u0436\u0456\u043d\u043e\u0447\u043e\u0457 \u043e\u0440\u0433\u0430\u043d\u0456\u0437\u0430\u0446\u0456\u0457 \"\u0414\u0430\u0440 \u0436\u0438\u0442\u0442\u044f\" \u0456 \u0456\u043d\u0448\u0438\u0445 \u043b\u0456\u0432\u0438\u0445 \u0441\u0438\u043b. \u0410\u043a\u0446\u0456\u044f \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u0442\u044c \u043f\u0456\u0434 \u043a\u0435\u0440\u0456\u0432\u043d\u0438\u0446\u0442\u0432\u043e\u043c \u041f\u0421\u041f\u0423, \u043f\u0430\u0440\u0442\u0456\u0439 \"\u0421\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u0456\u0441\u0442\u044c\" \u0456 \"\u0421\u0435\u043b\u044f\u043d\". \u0417\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0438 \u043b\u0456\u0434\u0435\u0440\u0430 \u041f\u0421\u041f\u0423 \u041d\u0430\u0442\u0430\u043b\u0456\u0457 \u0412\u0456\u0442\u0440\u0435\u043d\u043a\u043e, \u0443\u0447\u0430\u0441\u043d\u0438\u043a\u0438 \u0430\u043a\u0446\u0456\u0457 \u043c\u0430\u044e\u0442\u044c \u043d\u0430\u043c\u0456\u0440 \u043f\u0440\u043e\u0439\u0442\u0438 \u0434\u043e \u0412\u0435\u0440\u0445\u043e\u0432\u043d\u043e\u0457 \u0420\u0430\u0434\u0438, \u041a\u0430\u0431\u0456\u043d\u0435\u0442\u043e\u0432\u0456 \u043c\u0456\u043d\u0456\u0441\u0442\u0440\u0456\u0432 \u041d\u0430\u0446\u0431\u0430\u043d\u043a\u0443 \u0456 \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u0456\u0430\u0442\u0443 \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u0430. \u0417\u043e\u043a\u0440\u0435\u043c\u0430 \u0412\u0456\u0442\u0440\u0435\u043d\u043a\u043e \u0443\u0442\u043e\u0447\u043d\u0438\u043b\u0430, \u0449\u043e \u043b\u0456\u0434\u0435\u0440\u0438 \u043f\u0430\u0440\u0442\u0456\u0439-\u0443\u0447\u0430\u0441\u043d\u0438\u043a\u0456\u0432 \u0430\u043a\u0446\u0456\u0439 \u0431\u0443\u0434\u0443\u0442\u044c \u043e\u0447\u043e\u043b\u044e\u0432\u0430\u0442\u0438 \u043a\u043e\u043b\u043e\u043d\u0443 \u0439 \u043e\u0441\u043d\u043e\u0432\u043d\u0435 \u0433\u0430\u0441\u043b\u043e \u0445\u043e\u0434\u0443 - \"\u0413\u0435\u0442\u044c \u043a\u0430\u043f\u0456\u0442\u0430\u043b\u0456\u0441\u0442\u0438\u0447\u043d\u0435 \u0440\u0430\u0431\u0441\u0442\u0432\u043e - \u0434\u0430\u0454\u0448 \u0441\u043e\u0446\u0456\u0430\u043b\u0456\u0437\u043c\". \u041d\u0430 10 \u0433\u043e\u0434\u0438\u043d\u0443 \u0437\u0456\u0431\u0440\u0430\u043b\u043e\u0441\u044f \u0431\u043b\u0438\u0437\u044c\u043a\u043e 2 \u0442\u0438\u0441. \u0456 \u0443\u0447\u0430\u0441\u043d\u0438\u043a\u0438 \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0443\u044e\u0442\u044c \u0437\u0431\u0438\u0440\u0430\u0442\u0438\u0441\u044f. \u0412 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c\u0443 \u043b\u044e\u0434\u0438 \u043f\u043e\u0445\u0438\u043b\u043e\u0433\u043e \u0432\u0456\u043a\u0443 \u0456 \u043c\u043e\u043b\u043e\u0434\u0456. \u042f\u043a \u0440\u043e\u0437\u043f\u043e\u0432\u0456\u0432 \u043b\u0456\u0434\u0435\u0440 \u043f\u0430\u0440\u0442\u0456\u0457 \"\u0421\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u0456\u0441\u0442\u044c\" \u0421\u0442\u0430\u043d\u0456\u0441\u043b\u0430\u0432 \u041d\u0456\u043a\u043e\u043b\u0430\u0454\u043d\u043a\u043e, \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u0438 \u043b\u0456\u0432\u0438\u0445 \u043f\u0430\u0440\u0442\u0456\u0439 \u0434\u043e\u043c\u043e\u0432\u0438\u043b\u0438\u0441\u044f \u043f\u0440\u043e \u0442\u0435, \u0449\u043e \u043f\u0440\u043e\u0439\u0434\u0443\u0442\u044c \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0430\u0446\u0456\u0454\u044e \u0434\u043e \u041c\u0430\u0439\u0434\u0430\u043d\u0443 \u041d\u0435\u0437\u0430\u043b\u0435\u0436\u043d\u043e\u0441\u0442\u0456 \u0456 \u043f\u0440\u0438\u0431\u043b\u0438\u0437\u043d\u043e \u043e\u0431 11.30 \u043f\u043b\u0430\u043d\u0443\u044e\u0442\u044c \u0437\u0443\u0441\u0442\u0440\u0456\u0442\u0438\u0441\u044f \u043d\u0430 \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u0456\u0439 \u043f\u043b\u043e\u0449\u0456.* (UP 2009)\n\nAttendance: 2000 (UP, lower estimate)", "Attendance": 2000}, "id": "TzJKU"}], "properties": {"name": "PSPU", "color": "FireBrick", "fields": [{"key": "description", "type": "Text"}, {"key": "name", "type": "String"}, {"key": "Attendance", "type": "Number"}, {"key": "Slogan", "type": "String"}, {"key": "Lata", "type": "String"}], "iconUrl": "https://raw.githubusercontent.com/paweldow1/umap-assets/main/logo/kijow/pspu.png", "browsable": true, "inCaption": true, "remoteData": {}, "displayOnLoad": true}, "rank": 3}, {"type": "FeatureCollection", "features": [{"type": "Feature", "geometry": {"type": "LineString", "coordinates": [[30.560919, 50.42779], [30.538713, 50.427874]]}, "properties": {"_umap_options": {"dashArray": "10"}, "name": "2004. Party of Regions", "Lata": "2004", "description": "Representatives of the Regions Party, All-Ukrainian Party of Peace and Unity, Party of National Economic Development gathered at the Lesya Ukrainka Square. Demonstrators, under raspberry flags, expressed their support for Viktor Janukovych as the sole presidential candidate of the governing coalitions (Suspilne Media)\n\n*\u0417\u0430 \u0434\u0430\u043d\u0438\u043c\u0438 \u043c\u0456\u043b\u0456\u0446\u0456\u0457, \u0443 \u043c\u0456\u0442\u0438\u043d\u0433\u0443 \u041f\u0430\u0440\u0442\u0456\u0457 \u0440\u0435\u0433\u0456\u043e\u043d\u0456\u0432 \u0432\u0437\u044f\u043b\u0438 \u0443\u0447\u0430\u0441\u0442\u044c \u0431\u043b\u0438\u0437\u044c\u043a\u043e 10 \u0442\u0438\u0441\u044f\u0447 \u043e\u0441\u0456\u0431, \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u044f\u0454 \u0406\u043d\u0442\u0435\u0440\u0444\u0430\u043a\u0441-\u0423\u043a\u0440\u0430\u0457\u043d\u0430 .* (Ukr-pravda)", "Attendance": 10000}, "id": "heQMD"}, {"type": "Feature", "geometry": {"type": "LineString", "coordinates": [[30.550268, 50.440497], [30.545683, 50.443676], [30.542164, 50.444004], [30.537175, 50.446752], [30.535378, 50.447792], [30.535383, 50.447933], [30.536177, 50.449123]]}, "properties": {"description": "The column of SDPU(o) moved from the Slava square towards the Central Park of Culture and Recreation. There, a flower laying ceremony by the Lesya Ukrainka monument took place (Suspilne Media", "name": "2004. SDPU(o)", "Lata": "2004", "Attendance": 700}, "id": "3L9Gr"}, {"type": "Feature", "geometry": {"type": "Point", "coordinates": [30.539049, 50.447557]}, "properties": {"name": "2004. SDPU(o) concert", "Lata": "2004", "Attendance": 700, "description": "\u041e\u043a\u043e\u043b\u043e 700 \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u043a\u043e\u0432 \u0421\u0414\u041f\u0423(\u043e), \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c \u043c\u043e\u043b\u043e\u0434\u044b\u0445 \u043b\u044e\u0434\u0435\u0439, \u043f\u0440\u0438\u043d\u044f\u043b\u0438 \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u043f\u0440\u0430\u0437\u0434\u043d\u0438\u0447\u043d\u043e\u043c \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0435 \u043d\u0430 \u043b\u0435\u0442\u043d\u0435\u0439 \u043f\u043b\u043e\u0449\u0430\u0434\u043a\u0435 \u0426\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0433\u043e\u0440\u043e\u0434\u0441\u043a\u043e\u0433\u043e \u043f\u0430\u0440\u043a\u0430. (korrespondent.net)\n\n\u0411\u0443\u0432 \u0443 \u0441\u0443\u0431\u043e\u0442\u0443 \u0449\u0435 \u043f\u0430\u0440\u0442\u0456\u0439\u043d\u0438\u0439 \u043c\u0456\u0442\u0438\u043d\u0433 \u0435\u0441\u0434\u0435\u043a\u0456\u0432. \u0412\u0456\u0434 \u043b\u0456\u0434\u0435\u0440\u0456\u0432 \u0421\u0414\u041f\u0423(\u043e) \u043d\u0430 \u043d\u044c\u043e\u0433\u043e \u043f\u0440\u0438\u0439\u0448\u043b\u0438 \u0411\u043e\u0440\u0438\u0441 \u0410\u043d\u0434\u0440\u0435\u0441\u044e\u043a \u0456... \u0422\u0430\u043c\u0430\u0440\u0430 \u041f\u0440\u043e\u0448\u043a\u0443\u0440\u0430\u0442\u043e\u0432\u0430. \u0423\u0447\u0430\u0441\u043d\u0438\u043a\u0438 \u0430\u043a\u0446\u0456\u0457 \u0432 \u043f\u0430\u0440\u043a\u0443 \u0431\u0456\u043b\u044f \u041c\u0430\u0440\u0456\u0457\u043d\u0441\u044c\u043a\u043e\u0433\u043e \u043f\u0430\u043b\u0430\u0446\u0443 \u0442\u0440\u0438\u043c\u0430\u043b\u0438 \u043f\u043b\u0430\u043a\u0430\u0442\u0438 \u0437 \u043f\u0435\u0440\u0448\u043e\u0442\u0440\u0430\u0432\u043d\u0435\u0432\u0438\u043c\u0438 \u0437\u0430\u043a\u043b\u0438\u043a\u0430\u043c\u0438, \u0430 \u0442\u0430\u043a\u043e\u0436 \u0437 \u043d\u0435\u0442\u0440\u0430\u0434\u0438\u0446\u0456\u0439\u043d\u0438\u043c \u044f\u043a \u0434\u043b\u044f 1 \u0442\u0440\u0430\u0432\u043d\u044f, \u0430\u043b\u0435 \u0442\u0440\u0430\u0434\u0438\u0446\u0456\u0439\u043d\u0438\u043c \u0434\u043b\u044f \u0421\u0414\u041f\u0423(\u043e) \u0433\u0430\u0441\u043b\u043e\u043c: \"\u041d\u0430\u0448\u0438\u0437\u043c \u043d\u0435 \u043f\u0440\u043e\u0439\u0434\u0435\". (Ukrainska Pravda)"}, "id": "XIfSR"}, {"type": "Feature", "geometry": {"type": "Point", "coordinates": [30.524463, 50.449633]}, "properties": {"description": "\u041d\u0430 \u041c\u0430\u0439\u0434\u0430\u043d\u0456 \u041d\u0435\u0437\u0430\u043b\u0435\u0436\u043d\u043e\u0441\u0442\u0456 \u0432 \u041a\u0438\u0454\u0432\u0456 \u043f\u0440\u043e\u0439\u0448\u043b\u0430 \u0430\u043a\u0446\u0456\u044f \u0431\u043b\u043e\u043a\u0443 \u0412\u0456\u043a\u0442\u043e\u0440\u0430 \u042e\u0449\u0435\u043d\u043a\u0430 \"\u041a\u0430\u0440\u0430\u043e\u043a\u0435 \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u043e\u0457 \u043f\u0456\u0441\u043d\u0456\", \u043d\u0430 \u044f\u043a\u0443 \u0437\u0456\u0431\u0440\u0430\u043b\u043e\u0441\u044f \u0431\u043b\u0438\u0437\u044c\u043a\u043e 200 \u043e\u0441\u0456\u0431. \u0423\u0441\u0456 \u0431\u0430\u0436\u0430\u044e\u0447\u0456 \u043c\u043e\u0433\u043b\u0438 \u0432\u0437\u044f\u0442\u0438 \u0443\u0447\u0430\u0441\u0442\u044c \u0443 \u043a\u043e\u043d\u043a\u0443\u0440\u0441\u0456 \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u043e\u0457 \u043f\u0456\u0441\u043d\u0456, \u043f\u0435\u0440\u0435\u043c\u043e\u0436\u0446\u044e \u044f\u043a\u043e\u0433\u043e \u0434\u0456\u0441\u0442\u0430\u0432\u0441\u044f \u0433\u043e\u043b\u043e\u0432\u043d\u0438\u0439 \u043f\u0440\u0438\u0437 - \u043c\u0443\u0437\u0438\u0447\u043d\u0438\u0439 \u0446\u0435\u043d\u0442\u0440 Panason\u0456c. \u041f\u0435\u0440\u0435\u043c\u043e\u0436\u0446\u0456\u0432 \u043a\u043e\u043d\u043a\u0443\u0440\u0441\u0443 \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u043b\u0438 \u0436\u0438\u0442\u0435\u043b\u0456 \u0456 \u0433\u043e\u0441\u0442\u0456 \u0441\u0442\u043e\u043b\u0438\u0446\u0456, \u0430 \u0442\u0430\u043a\u043e\u0436 \u0436\u0443\u0440\u0456, \u0434\u043e \u0441\u043a\u043b\u0430\u0434\u0443 \u044f\u043a\u043e\u0433\u043e \u0432\u0432\u0456\u0439\u0448\u043b\u0438 \u043d\u0430\u0440\u043e\u0434\u043d\u0456 \u0434\u0435\u043f\u0443\u0442\u0430\u0442\u0438 \u0411\u043e\u0440\u0438\u0441 \u0411\u0435\u0437\u043f\u0430\u043b\u0438\u0439, \u0412\u043e\u043b\u043e\u0434\u0438\u043c\u0438\u0440 \u0411\u043e\u043d\u0434\u0430\u0440\u0435\u043d\u043a\u043e \u0456 \u0434\u0435\u043f\u0443\u0442\u0430\u0442 \u041a\u0438\u0457\u0432\u0440\u0430\u0434\u0438 \u041e\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440 \u041a\u0443\u043b\u0438\u043a. (korrespondent.net)", "name": "2004. \u041a\u0430\u0440\u0430\u043e\u043a\u0435 \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u043e\u0457 \u043f\u0456\u0441\u043d\u0456 (Nasha Ukraiyna)", "Lata": "2004", "Attendance": 200}, "id": "G2cBO"}, {"type": "Feature", "geometry": {"type": "Point", "coordinates": [30.527321, 50.446092]}, "properties": {"name": "2008. SDPU(o) rally", "Lata": "2008", "description": "*\u0410 \u043d\u0430 \u043f\u043b\u043e\u0449\u0430\u0434\u0438 \u0418\u0432\u0430\u043d\u0430 \u0424\u0440\u0430\u043d\u043a\u043e \u0432 \u041a\u0438\u0435\u0432\u0435 \u0441\u0432\u043e\u0439 \u043c\u0438\u0442\u0438\u043d\u0433 \u043f\u043e \u0441\u043b\u0443\u0447\u0430\u044e 1 \u043c\u0430\u044f \u043f\u0440\u043e\u0432\u0435\u043b\u0438 \u043e\u043a\u043e\u043b\u043e 200 \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u043a\u043e\u0432 \u0421\u043e\u0446\u0438\u0430\u043b-\u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043