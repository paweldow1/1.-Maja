0 \u041e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0438 \u0432\u0435\u0442\u0435\u0440\u0430\u043d\u043e\u0432 \u0423\u043a\u0440\u0430\u0438\u043d\u044b \u041f\u0435\u0442\u0440 \u0426\u044b\u0431\u0435\u043d\u043a\u043e.* (kpu.org.ua)\n\nAttendance: 1000 (KPU)\nPolice: 800 (up.ua)", "Attendance": 900, "Lata": "2015"}, "id": "ux58j"}, {"type": "Feature", "geometry": {"coordinates": [30.529869, 50.454526], "type": "Point"}, "properties": {"name": "2017 \u2013 Socijalisty rally", "Lata": "2017"}, "id": "ctMay"}, {"type": "Feature", "geometry": {"coordinates": [[30.529782, 50.454513], [30.529541, 50.454273], [30.529203, 50.454068], [30.528812, 50.453607], [30.528672, 50.453139], [30.528028, 50.452565], [30.528302, 50.451799], [30.530394, 50.449968], [30.535297, 50.447797], [30.539449, 50.445487], [30.539677, 50.445368], [30.539814, 50.445542], [30.539873, 50.445706], [30.539685, 50.445761], [30.540077, 50.445798], [30.540458, 50.445942], [30.541021, 50.445682], [30.541068, 50.445575]], "type": "LineString"}, "properties": {"name": "2017 \u2013 \u0421\u043e\u0446\u0456\u044f\u043b\u0456\u0441\u0442\u0438", "description": "trasa via (\u0422\u0421\u041d)", "Lata": "2017"}, "id": "k2Mu6"}, {"type": "Feature", "geometry": {"coordinates": [[30.527511, 50.452618], [30.524109, 50.450185]], "type": "LineString"}, "properties": {"name": "2018 KPU Demonstration", "Attendance": 500, "Lata": "2018", "description": "While most people od\u0142\u0105czy\u0142o si\u0119 od demonstracji, 500 os\u00f3b uda\u0142o si\u0119 w stron\u0119 Ukrai\u0144skiego Domu, gdzie odby\u0142 si\u0119 wiec, w kt\u00f3rym udzia\u0142 brali cz\u0142onkowie KPU, Partii Zielonych, Miejskiej Rady Kijowskich Zwi\u0105zk\u00f3w Zawodowych"}, "id": "8jMRV"}, {"type": "Feature", "geometry": {"type": "LineString", "coordinates": [[30.545546, 50.443777], [30.542186, 50.444044], [30.529588, 50.450483], [30.527313, 50.452329], [30.524118, 50.450363], [30.522317, 50.448416], [30.520213, 50.442346]]}, "properties": {"Lata": "2006", "name": "2006. Communist Party Demonstration", "description": "*\u0417\u043e\u043a\u0440\u0435\u043c\u0430, \u041a\u0438\u0457\u0432\u0441\u044c\u043a\u0430 \u043c\u0456\u0441\u044c\u043a\u0430 \u043e\u0440\u0433\u0430\u043d\u0456\u0437\u0430\u0446\u0456\u044f \u041a\u043e\u043c\u0443\u043d\u0456\u0441\u0442\u0438\u0447\u043d\u043e\u0457 \u043f\u0430\u0440\u0442\u0456\u0457 \u0423\u043a\u0440\u0430\u0457\u043d\u0438 \u043f\u0440\u043e\u0432\u0435\u0434\u0435 \u043c\u0456\u0442\u0438\u043d\u0433-\u0445\u043e\u0434\u0443 \u0437\u0430 \u0443\u0447\u0430\u0441\u0442\u044e 5 \u0442\u0438\u0441\u044f\u0447 \u0447\u043e\u043b\u043e\u0432\u0456\u043a \u0437 9.00 \u0434\u043e 13.00 \u0437\u0430 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u043e\u043c \"\u0421\u0442\u0430\u043d\u0446\u0456\u044f \u043c\u0435\u0442\u0440\u043e \"\u0410\u0440\u0441\u0435\u043d\u0430\u043b\u044c\u043d\u0430\" - \u041c\u0430\u0439\u0434\u0430\u043d \u041d\u0435\u0437\u0430\u043b\u0435\u0436\u043d\u043e\u0441\u0442\u0456 - \u043f\u0430\u043c\u2019\u044f\u0442\u043d\u0438\u043a \u041b\u0435\u043d\u0456\u043d\u0443\".* (korrespondent 2006)"}, "id": "iqNXz"}, {"type": "Feature", "geometry": {"type": "LineString", "coordinates": [[30.550469, 50.440493], [30.545619, 50.443814], [30.542142, 50.444224], [30.529457, 50.450729], [30.527936, 50.451855], [30.527507, 50.452334]]}, "properties": {"Lata": "2003", "name": "2003. KPU Demonstration", "description": "*1 \u0442\u0440\u0430\u0432\u043d\u044f \u043a\u043e\u043c\u0443\u043d\u0456\u0441\u0442\u0438 \u0431\u0443\u0434\u0443\u0442\u044c \u0444\u043e\u0440\u043c\u0443\u0432\u0430\u0442\u0438 \u043a\u043e\u043b\u043e\u043d\u0443 \u0437 9.00 \u0434\u043e 10.00 \u0431\u0456\u043b\u044f \u043f\u043b\u043e\u0449\u0456 \u0421\u043b\u0430\u0432\u0438, \u043f\u043e\u0442\u0456\u043c \u0440\u0443\u0448\u0430\u0442\u044c \u043f\u043e \u0432\u0443\u043b\u0438\u0446\u0456 \u0413\u0440\u0443\u0448\u0435\u0432\u0441\u044c\u043a\u043e\u0433\u043e \u0434\u043e \u0404\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u044c\u043a\u043e\u0457 \u043f\u043b\u043e\u0449\u0456.* (UP 29-04-2003)"}, "id": "nVEYo"}], "properties": {"name": "Communist Party", "color": "Red", "fields": [{"key": "name", "type": "String"}, {"key": "description", "type": "Text"}, {"key": "osm_type", "type": "String"}, {"key": "osm_id", "type": "String"}, {"key": "osm_key", "type": "String"}, {"key": "osm_value", "type": "String"}, {"key": "type", "type": "String"}, {"key": "street", "type": "String"}, {"key": "locality", "type": "String"}, {"key": "district", "type": "String"}, {"key": "city", "type": "String"}, {"key": "country", "type": "String"}, {"key": "postcode", "type": "String"}, {"key": "countrycode", "type": "String"}, {"key": "Attendance", "type": "Number"}, {"key": "Lata", "type": "String"}], "iconUrl": "https://raw.githubusercontent.com/paweldow1/umap-assets/main/logo/kijow/kpu.png?2", "browsable": true, "inCaption": true, "showLabel": false, "remoteData": {}, "displayOnLoad": true, "popupTemplate": "Route", "popupContentTemplate": ""}, "rank": 1}, {"type": "FeatureCollection", "features": [{"type": "Feature", "geometry": {"coordinates": [[30.516054, 50.439246], [30.51665, 50.439311], [30.519666, 50.44063], [30.520119, 50.442204], [30.520804, 50.444036], [30.522124, 50.447814], [30.522468, 50.448552], [30.523755, 50.449851], [30.527082, 50.452174], [30.527189, 50.452393], [30.526138, 50.453036], [30.525451, 50.453432], [30.524871, 50.454293], [30.523541, 50.454744], [30.522042, 50.455274], [30.520438, 50.455137], [30.519826, 50.455281], [30.518136, 50.45539], [30.517203, 50.455373], [30.514874, 50.455438], [30.513479, 50.455383], [30.510882, 50.455287], [30.509508, 50.455178], [30.50822, 50.455178], [30.506374, 50.455328], [30.505602, 50.455561], [30.502257, 50.456434], [30.501377, 50.456461], [30.497364, 50.456325], [30.493135, 50.456202], [30.490581, 50.456147], [30.48953, 50.456557], [30.487903, 50.457375], [30.486551, 50.458633]], "type": "LineString"}, "properties": {"description": "*The Kyiv City Executive Committee's permit stipulated that the Rukh column would reach Leninsky Komsomol Square, and from there return to October Revolution Square, where a rally would be held. But this rally never took place \u2014 the residents of Kyiv never got to hear what the Rukh and URP activists wanted to say to them on International Workers' Solidarity Day. The fact is that at Leninsky Komsomol Square the column suddenly turned left and, along Heroes of the Revolution, Velyka Zhytomyrska, and Artema streets, moved toward Lukyanivska Prison, naturally paralyzing traffic on these streets. Running into a police cordon near the tram depot, the Rukh members began rallying around the well-known slogan \"Freedom for Khmara,\" which constituted yet another unprecedented act of pressure on the republic's Supreme Court.* (Pravda Ukrainy, 2.05.1991)\n\n## Miners at the front of the demonstration\n\nNa czele demonstracji sz\u0142a grupa g\u00f3rnik\u00f3w z transparentem \"Ukrainie \u2013 wolno\u015b\u0107!\". Najprawdopodobniej byli to przedstawiciele g\u00f3rniczych komitet\u00f3w strajkowych, w kt\u00f3rych przewa\u017cali g\u00f3rnicy z Donbasu wspierani przez g\u00f3rnik\u00f3w z Zag\u0142\u0119bia Lwowskiego. 16 kwietnia zak\u0142adaj\u0105 oni republika\u0144ski komitet strajkowy, 18 kwietnia podpisuj\u0105 z kolei umow\u0119 z w\u0142adzami republiki Ukrai\u0144skiej w Kijowie", "name": "1991 Rukh Demonstration", "Lata": "1991", "Attendance": 5500}, "id": "vHrNF"}, {"type": "Feature", "geometry": {"coordinates": [[30.513461, 50.441766], [30.513925, 50.443513], [30.512552, 50.443759], [30.514355, 50.44846], [30.516415, 50.453488]], "type": "LineString"}, "properties": {"name": "1999 Narodnyi Rukh demonstration", "description": "*\u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u0438 \u041d\u0430\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u0440\u0443\u0445\u0443 \u043f\u0440\u043e\u0432\u0435\u043b\u0438 \u043f\u0456\u0448\u0438\u0439 \u0445\u0456\u0434 \u0432\u0456\u0434 \u043f\u0430\u043c\u02bc\u044f\u0442\u043d\u0438\u043a\u0430 \u0422\u0430\u0440\u0430\u0441\u043e\u0432\u0456 \u0428\u0435\u0432\u0447\u0435\u043d\u043a\u043e\u0432\u0456 \u0434\u043e \u0421\u043e\u0444\u0456\u0439\u0441\u044c\u043a\u043e\u0457 \u043f\u043b\u043e\u0449\u0456, \u0434\u0435 \u0432\u0456\u0434\u0431\u0443\u0432\u0441\u044f \u043c\u0456\u0442\u0438\u043d\u0433. \u041b\u0456\u0434\u0435\u0440 \u041d\u0420\u0423 \u042e\u0440\u0456\u0439 \u041a\u043e\u0441\u0442\u0435\u043d\u043a\u043e \u0437\u0430\u044f\u0432\u0438\u0432,\u0449\u043e \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u043d\u0456 \u043f\u0430\u0440\u0442\u0456\u0457 \u043f\u043e\u0432\u0438\u043d\u043d\u0456\u043e\u0431\u02bc\u0454\u0434\u043d\u0430\u0442\u0438\u0441\u044f \u0434\u043b\u044f \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u0438\u0445 \u0440\u0456\u0448\u0435\u043d\u044c \u0437 \u043f\u0438\u0442\u0430\u043d\u044c \u0441\u043e\u0446\u0456\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0437\u0430\u0445\u0438\u0441\u0442\u0443 \u043d\u0430\u0441\u0435\u043b\u0435\u043d\u043d\u044f, \u0432\u0438\u043f\u043b\u0430\u0442\u0438\u0437\u0430\u0440\u043f\u043b\u0430\u0442 \u0456 \u043f\u0435\u043d\u0441\u0456\u0439, \u0437\u0430\u0445\u0438\u0441\u0442\u0443 \u0456\u043d\u0442\u0435\u0440\u0435\u0441\u0456\u0432 \u0442\u0440\u0443\u0434\u044f\u0449\u0438\u0445.* (Holos Ukrainy, 1999)", "Lata": "1999"}, "id": "0DduR"}, {"type": "Feature", "geometry": {"type": "LineString", "coordinates": [[30.513795, 50.442008], [30.514033, 50.443513], [30.51251, 50.443636], [30.516393, 50.45342], [30.516006, 50.453426]]}, "properties": {"Lata": "1996", "name": "1996. Narodnyi Rukh demonstration", "description": "(Suspilne mediateka)"}, "id": "EHYkS"}], "properties": {"name": "Narodnyi Rukh", "color": "DodgerBlue", "fields": [{"key": "na